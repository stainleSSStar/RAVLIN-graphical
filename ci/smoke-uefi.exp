#!/usr/bin/expect -f
#
# RAVLIN Graphical UEFI boot test.
#
# Boots the built ISO with OVMF so the EFI bootloader chain (OVMF ->
# GRUB EFI -> kernel) is exercised, then verifies the live session over the
# serial console (console=ttyS0 is part of the ISO kernel cmdline; the live
# image enables a serial getty for it). GRUB auto-boots the default entry
# after its timeout.
#
# Checks:
#   1. the ISO reaches a login prompt via the EFI bootloader chain
#   2. root lands in fish with the RAVLIN config
#   3. /etc/os-release identifies RAVLIN Graphical
#   4. SDDM is running (graphical session starting)

set timeout 2400
log_file -noappend serial-uefi.log

# Use KVM when available, fall back to TCG.
set ISO [glob ravlin-graphical-live-*.iso]
set QEMU_ARGS "-m 4096 -smp 4 -nographic -no-reboot -bios /usr/share/ovmf/OVMF.fd -cdrom $ISO"
if {[file exists /dev/kvm] && [file writable /dev/kvm]} { append QEMU_ARGS " -enable-kvm" }
eval spawn qemu-system-x86_64 $QEMU_ARGS

expect {
    "login:" { puts "\n=== CHECK 1 PASSED: booted via the UEFI bootloader chain ===" }
    timeout  { puts "\n=== CHECK 1 FAILED: UEFI boot timeout ==="; exit 1 }
    eof      { puts "\n=== CHECK 1 FAILED: qemu exited ==="; exit 1 }
}

set timeout 120
send "root\r"
expect "Password:"
send "voidlinux\r"

expect {
    "minimal Void Linux remix" { puts "\n=== CHECK 2 PASSED: fish + RAVLIN config ===" }
    timeout { puts "\n=== CHECK 2 FAILED: no RAVLIN fish greeting ==="; exit 1 }
}

send "grep PRETTY /etc/os-release\r"
expect {
    "RAVLIN Graphical 0.1.0" { puts "\n=== CHECK 3 PASSED: RAVLIN Graphical os-release ===" }
    timeout { puts "\n=== CHECK 3 FAILED: os-release wrong ==="; exit 1 }
}

set timeout 600
send "sv status sddm\r"
expect {
    "run: sddm" { puts "\n=== CHECK 4 PASSED: sddm running ===" }
    timeout { puts "\n=== CHECK 4 FAILED: sddm not running ==="; exit 1 }
}

puts "\n=== ALL UEFI BOOT CHECKS PASSED ==="
send "\001x"
expect eof

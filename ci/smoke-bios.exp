#!/usr/bin/expect -f
#
# RAVLIN Graphical BIOS boot test.
#
# Boots the built ISO through its own bootloader chain (SeaBIOS ->
# ISOLINUX -> kernel) — no -kernel/-initrd shortcuts — and drives the live
# session over the serial console. The ISO kernel cmdline carries
# console=ttyS0 (set in build.sh); the vmklive live image enables a serial
# getty when it sees it, even though SDDM owns the graphical tty1.
#
# Checks:
#   1. the ISO reaches a login prompt via its bootloader
#   2. root lands in fish with the RAVLIN config
#   3. root's login shell is really fish
#   4. void-installer is on the image
#   5. /etc/os-release identifies RAVLIN Graphical
#   6. dhcpcd and wpa_supplicant are actually running (sv status), not
#      merely enabled
#   7. ALSA detects the emulated sound card (aplay -l)
#   8. the live hostname is ravlin (the patched vmklive boot hook)
#   9. the graphical stack is up: SDDM + elogind running; PipeWire installed
#      and wired for session autostart (it runs per-user in the Plasma
#      session, not as a runit service)
#
# fish wraps command echoes in ANSI escapes; only contiguous output
# substrings are matched.

set timeout 2400
log_file -noappend serial-bios.log

spawn qemu-system-x86_64 -m 4096 -smp 2 -nographic -no-reboot \
    -nic user,model=virtio-net-pci \
    -device intel-hda -device hda-duplex \
    -cdrom [glob ravlin-graphical-live-*.iso] -boot d

expect {
    "login:" { puts "\n=== CHECK 1 PASSED: booted via the ISOLINUX bootloader ===" }
    timeout  { puts "\n=== CHECK 1 FAILED: boot timeout ==="; exit 1 }
    eof      { puts "\n=== CHECK 1 FAILED: qemu exited ==="; exit 1 }
}

set timeout 120
send "root\r"
expect "Password:"
send "voidlinux\r"

expect {
    "minimal Void Linux remix" { puts "\n=== CHECK 2 PASSED: fish + RAVLIN config ===" }
    timeout { puts "\n=== CHECK 2 FAILED: no RAVLIN fish greeting ==="; exit 1 }
}

send "status fish-path\r"
expect {
    "/usr/bin/fish" { puts "\n=== CHECK 3 PASSED: root shell is fish ===" }
    timeout { puts "\n=== CHECK 3 FAILED: shell is not fish ==="; exit 1 }
}

send "command -v void-installer\r"
expect {
    "/usr/bin/void-installer" { puts "\n=== CHECK 4 PASSED: void-installer present ===" }
    timeout { puts "\n=== CHECK 4 FAILED: void-installer missing ==="; exit 1 }
}

send "grep PRETTY /etc/os-release\r"
expect {
    "RAVLIN Graphical 0.1.0" { puts "\n=== CHECK 5 PASSED: RAVLIN Graphical os-release ===" }
    timeout { puts "\n=== CHECK 5 FAILED: os-release wrong ==="; exit 1 }
}

# service health: runit must be supervising them and they must be running
send "sv status dhcpcd wpa_supplicant\r"
expect {
    "run: dhcpcd" { puts "\n=== CHECK 6 PASSED: dhcpcd running ===" }
    timeout { puts "\n=== CHECK 6 FAILED: dhcpcd not running ==="; exit 1 }
}
expect {
    "run: wpa_supplicant" { puts "\n=== CHECK 6b PASSED: wpa_supplicant running ===" }
    timeout { puts "\n=== CHECK 6b FAILED: wpa_supplicant not running ==="; exit 1 }
}

# sound: the emulated HDA card must be detected by the ALSA stack
send "aplay -l\r"
expect {
    "card 0" { puts "\n=== CHECK 7 PASSED: ALSA sees the sound card ===" }
    timeout { puts "\n=== CHECK 7 FAILED: no sound card detected ==="; exit 1 }
}

# the patched live hostname hook must have named the machine ravlin
# (upstream vmklive rewrites /etc/hostname to void-live at every boot).
# The success marker only appears if the test passes, and is assembled
# from split tokens so the typed command's echo cannot match the pattern.
send "test (hostname) = ravlin; and string join '' HOSTNAME _OK\r"
expect {
    "HOSTNAME_OK" { puts "\n=== CHECK 8 PASSED: live hostname is ravlin ===" }
    timeout { puts "\n=== CHECK 8 FAILED: live hostname is not ravlin ==="; exit 1 }
}

# graphical stack: SDDM must be supervised and running; under TCG Plasma
# takes a while to come up, so give the service check room.
set timeout 600
send "sv status sddm\r"
expect {
    "run: sddm" { puts "\n=== CHECK 9 PASSED: sddm (display manager) running ===" }
    timeout { puts "\n=== CHECK 9 FAILED: sddm not running ==="; exit 1 }
}

# elogind is D-Bus-activated (no working runit service on cgroup v2), so
# check for the process, not sv status.
send "pgrep -x elogind\r"
expect {
    -re {[0-9]+} { puts "\n=== CHECK 9b PASSED: elogind running (D-Bus activated) ===" }
    timeout { puts "\n=== CHECK 9b FAILED: elogind not running ==="; exit 1 }
}

# PipeWire is a per-user session process (XDG autostart), not a runit
# service — verify the package and its system-wide wiring instead.
send "command -v pipewire\r"
expect {
    "/usr/bin/pipewire" { puts "\n=== CHECK 9c PASSED: pipewire installed ===" }
    timeout { puts "\n=== CHECK 9c FAILED: pipewire missing ==="; exit 1 }
}
send "test -L /etc/xdg/autostart/pipewire.desktop -a -L /etc/pipewire/pipewire.conf.d/10-wireplumber.conf -a -L /etc/pipewire/pipewire.conf.d/20-pipewire-pulse.conf; and string join '' PIPEWIRE _WIRED _OK\r"
expect {
    "PIPEWIRE_WIRED_OK" { puts "\n=== CHECK 9d PASSED: pipewire session autostart wired ===" }
    timeout { puts "\n=== CHECK 9d FAILED: pipewire autostart not wired ==="; exit 1 }
}

puts "\n=== ALL BIOS BOOT CHECKS PASSED ==="
send "\001x"
expect eof

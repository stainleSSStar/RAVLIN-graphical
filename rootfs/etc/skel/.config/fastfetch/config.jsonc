{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/ravlin/fastfetch-logo.txt",
        "color": { "1": "green", "2": "bright_green", "3": "green", "4": "bright_green", "5": "green", "6": "bright_green" },
        "padding": { "top": 1, "left": 1 }
    },
    "display": { "separator": "  " },
    "modules": [
        "title", "separator",
        "os", "host", "kernel", "uptime", "packages",
        "shell", "de", "wm", "terminal", "terminalfont",
        "cpu", "gpu", "memory", "disk", "localip", "battery",
        "break",
        "colors"
    ]
}
